type Merge {
  first: Integer;
  second: Integer;
  result: Integer;
  rank: Integer;
}
type Tokenizer {
  vocab: Map<Array<Integer>, Integer>;
  inverseVocab: Map<Integer, Array<Integer>>;
  merges: Array<Merge>;
  mergeRanks: Map<String, Integer>;
  specialTokens: Map<String, Integer>;
  specialIds: Map<Integer, String>;
}
type TokenizerConfig {
  vocabSize: Integer;
  specialTokens: Array<String>;
  unkToken: String;
  bosToken: String;
  eosToken: String;
  padToken: String;
  normalizeUnicode: Boolean;
}
func defaultConfig() -> TokenizerConfig {
  return TokenizerConfig {
    vocabSize: 10000,
    specialTokens: ["<PAD>", "<UNK>", "<BOS>", "<EOS>", "<SEP>"],
    unkToken: "<UNK>",
    bosToken: "<BOS>",
    eosToken: "<EOS>",
    padToken: "<PAD>",
    normalizeUnicode: true
  };
}
func stringToBytes(s: String) -> Array<Integer> {
  new bytes: Array<Integer> = [];
  new i = 0;
  while i < s.length {
    new cp = s.codePointAt(i);
    if cp == null { cp = 0xFFFD; }
    if cp < 0x80 {
      bytes.push(cp);
    } else if cp < 0x800 {
      bytes.push(0xC0 | (cp >> 6));
      bytes.push(0x80 | (cp & 0x3F));
    } else if cp < 0x10000 {
      bytes.push(0xE0 | (cp >> 12));
      bytes.push(0x80 | ((cp >> 6) & 0x3F));
      bytes.push(0x80 | (cp & 0x3F));
    } else {
      bytes.push(0xF0 | (cp >> 18));
      bytes.push(0x80 | ((cp >> 12) & 0x3F));
      bytes.push(0x80 | ((cp >> 6) & 0x3F));
      bytes.push(0x80 | (cp & 0x3F));
    }
    if cp > 0xFFFF { i = i + 2; } else if cp > 0x7FF { i = i + 2; } else if cp > 0x7F { i = i + 1; } else { i = i + 1; }
  }
  return bytes;
}
func bytesToString(bytes: Array<Integer>) -> String {
  new out = "";
  new i = 0;
  while i < bytes.length {
    new b = bytes[i];
    if b < 0x80 {
      out = out + String.fromCharCode(b);
      i = i + 1;
    } else if b >= 0xC0 && b < 0xE0 && i + 1 < bytes.length {
      new cp = ((b & 0x1F) << 6) | (bytes[i+1] & 0x3F);
      out = out + String.fromCharCode(cp);
      i = i + 2;
    } else if b >= 0xE0 && b < 0xF0 && i + 2 < bytes.length {
      new cp = ((b & 0x0F) << 12) | ((bytes[i+1] & 0x3F) << 6) | (bytes[i+2] & 0x3F);
      out = out + String.fromCharCode(cp);
      i = i + 3;
    } else if b >= 0xF0 && b < 0xF8 && i + 3 < bytes.length {
      new cp = ((b & 0x07) << 18) | ((bytes[i+1] & 0x3F) << 12) | ((bytes[i+2] & 0x3F) << 6) | (bytes[i+3] & 0x3F);
      out = out + String.fromCharCode(cp);
      i = i + 4;
    } else {
      out = out + "<0x" + b.toHex() + ">";
      i = i + 1;
    }
  }
  return out;
}
func normalizeText(text: String, config: TokenizerConfig) -> String {
  if !config.normalizeUnicode { return text; }
  return text.normalize("NFC");
}
func createTokenizer(config: TokenizerConfig) -> Tokenizer {
  new vocab: Map<Array<Integer>, Integer> = {};
  new inverse: Map<Integer, Array<Integer>> = {};
  new specialTokens: Map<String, Integer> = {};
  new specialIds: Map<Integer, String> = {};
  new id = 0;
  for token in config.specialTokens {
    new bytes = stringToBytes(token);
    vocab.set(bytes, id);
    inverse.set(id, bytes);
    specialTokens.set(token, id);
    specialIds.set(id, token);
    id = id + 1;
  }
  new i = 0;
  while i < 256 {
    new byteArr: Array<Integer> = [i];
    if !vocab.has(byteArr) {
      vocab.set(byteArr, id);
      inverse.set(id, byteArr);
      id = id + 1;
    }
    i = i + 1;
  }
  return Tokenizer {
    vocab: vocab,
    inverseVocab: inverse,
    merges: [],
    mergeRanks: {},
    specialTokens: specialTokens,
    specialIds: specialIds
  };
}
func pairKey(a: Integer, b: Integer) -> String {
  return a + " " + b;
}
func countBytePairFrequencies(byteFreqs: Map<Array<Integer>, Integer>) -> Map<String, Integer> {
  new pairCounts: Map<String, Integer> = {};
  for bytes in byteFreqs.keys() {
    new freq = byteFreqs.get(bytes);
    new i = 0;
    while i < bytes.length - 1 {
      new key = pairKey(bytes[i], bytes[i+1]);
      new count = pairCounts.get(key);
      if count == null { count = 0; }
      pairCounts.set(key, count + freq);
      i = i + 1;
    }
  }
  return pairCounts;
}
func findBestPair(pairCounts: Map<String, Integer>) -> { first: Integer; second: Integer } | null {
  new bestKey: String | null = null;
  new bestCount = 0;
  for key in pairCounts.keys() {
    new count = pairCounts.get(key);
    if count > bestCount {
      bestCount = count;
      bestKey = key;
    }
  }
  if bestKey == null { return null; }
  new parts = bestKey.split(" ");
  return { first: Integer(parts[0]), second: Integer(parts[1]) };
}
func applyMergeToFrequencies(byteFreqs: Map<Array<Integer>, Integer>, pair: { first: Integer; second: Integer }, newTokenId: Integer) -> Map<Array<Integer>, Integer> {
  new newFreqs: Map<Array<Integer>, Integer> = {};
  for bytes in byteFreqs.keys() {
    new freq = byteFreqs.get(bytes);
    new newBytes: Array<Integer> = [];
    new i = 0;
    while i < bytes.length {
      if i < bytes.length - 1 && bytes[i] == pair.first && bytes[i+1] == pair.second {
        newBytes.push(newTokenId);
        i = i + 2;
      } else {
        newBytes.push(bytes[i]);
        i = i + 1;
      }
    }
    newFreqs.set(newBytes, freq);
  }
  return newFreqs;
}
func getByteFrequencies(corpus: Array<String>, config: TokenizerConfig) -> Map<Array<Integer>, Integer> {
  new freqs: Map<Array<Integer>, Integer> = {};
  for line in corpus {
    new norm = normalizeText(line, config);
    new words = norm.split(" ");
    for word in words {
      if word.length == 0 { continue; }
      new bytes = stringToBytes(word);
      new count = freqs.get(bytes);
      if count == null { count = 0; }
      freqs.set(bytes, count + 1);
    }
  }
  return freqs;
}
func trainTokenizer(corpus: Array<String>, config: TokenizerConfig) -> Result<Tokenizer, String> {
  new tokenizer = createTokenizer(config);
  new byteFreqs = getByteFrequencies(corpus, config);
  new nextId = tokenizer.vocab.size();
  new merges: Array<Merge> = [];
  new mergeRanks: Map<String, Integer> = {};
  new rank = 0;
  while tokenizer.vocab.size() < config.vocabSize {
    new pairCounts = countBytePairFrequencies(byteFreqs);
    if pairCounts.size() == 0 { break; }
    new best = findBestPair(pairCounts);
    if best == null { break; }
    new newTokenBytes: Array<Integer> = [best.first, best.second];
    new newId: Integer;
    if tokenizer.vocab.has(newTokenBytes) {
      newId = tokenizer.vocab.get(newTokenBytes);
    } else {
      newId = nextId;
      nextId = nextId + 1;
      tokenizer.vocab.set(newTokenBytes, newId);
      tokenizer.inverseVocab.set(newId, newTokenBytes);
    }
    merges.push({ first: best.first, second: best.second, result: newId, rank: rank });
    mergeRanks.set(pairKey(best.first, best.second), rank);
    rank = rank + 1;
    byteFreqs = applyMergeToFrequencies(byteFreqs, best, newId);
  }
  tokenizer.merges = merges;
  tokenizer.mergeRanks = mergeRanks;
  return Ok(tokenizer);
}
func encode(tokenizer: Tokenizer, text: String, config: TokenizerConfig) -> Array<Integer> {
  new norm = normalizeText(text, config);
  new bytes = stringToBytes(norm);
  new current: Array<Integer> = [];
  for b in bytes {
    new byteArr: Array<Integer> = [b];
    new id = tokenizer.vocab.get(byteArr);
    if id == null { id = tokenizer.specialTokens.get("<UNK>"); }
    current.push(id);
  }
  while true {
    new bestRank = -1;
    new bestPos = -1;
    new bestMerge: Merge | null = null;
    new i = 0;
    while i < current.length - 1 {
      new key = pairKey(current[i], current[i+1]);
      new rank = tokenizer.mergeRanks.get(key);
      if rank != null && (bestRank == -1 || rank < bestRank) {
        bestRank = rank;
        bestPos = i;
        for m in tokenizer.merges {
          if m.first == current[i] && m.second == current[i+1] && m.rank == rank {
            bestMerge = m;
            break;
          }
        }
      }
      i = i + 1;
    }
    if bestMerge == null { break; }
    new newCurrent: Array<Integer> = [];
    new j = 0;
    while j < current.length {
      if j == bestPos && j + 1 < current.length {
        newCurrent.push(bestMerge.result);
        j = j + 2;
      } else {
        newCurrent.push(current[j]);
        j = j + 1;
      }
    }
    current = newCurrent;
  }
  return current;
}
func decode(tokenizer: Tokenizer, ids: Array<Integer>) -> String {
  new allBytes: Array<Integer> = [];
  for id in ids {
    if tokenizer.specialIds.has(id) {
      new tokStr = tokenizer.specialIds.get(id);
      new tokBytes = stringToBytes(tokStr);
      allBytes = allBytes + tokBytes;
    } else {
      new byteSeq = tokenizer.inverseVocab.get(id);
      if byteSeq == null {
        new unkBytes = stringToBytes("<UNK>");
        allBytes = allBytes + unkBytes;
      } else {
        allBytes = allBytes + byteSeq;
      }
    }
  }
  return bytesToString(allBytes);
}
func main() -> Integer {
  new corpus = [
    "hello world",
    "hello world again",
    "lumina tokenizer test",
    "byte level bpe"
  ];
  new config = defaultConfig();
  config.vocabSize = 200;
  match trainTokenizer(corpus, config) {
    case Ok(tokenizer) -> {
      display.show("Vocab size: ", tokenizer.vocab.size(), "\n");
      new text = "hello world again";
      new ids = encode(tokenizer, text, config);
      display.show("Encoded: ", ids, "\n");
      new decoded = decode(tokenizer, ids);
      display.show("Decoded: ", decoded, "\n");
    }
    case Err(msg) -> display.show("Training failed: ", msg, "\n");
  }
  return 0;
}
